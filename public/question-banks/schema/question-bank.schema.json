{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/question-bank.schema.json",
  "title": "Question Bank",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "assetsBase": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": { "type": { "const": "text" }, "text": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "src", "alt"],
          "properties": {
            "type": { "const": "image" },
            "src": { "type": "string", "minLength": 1 },
            "alt": { "type": "string" },
            "caption": { "type": "string" },
            "maxWidth": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "note" },
            "title": { "type": "string" },
            "text": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "richContent": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentBlock" } }
      ]
    },
    "option": {
      "type": "object",
      "required": ["id", "content"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "content": { "$ref": "#/$defs/richContent" }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "stem", "answer"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["single", "multiple", "judgement"] },
        "stem": { "$ref": "#/$defs/richContent" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "answer": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "explanation": { "$ref": "#/$defs/richContent" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
